{
  "name": "pulseboard",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @pulseboard/dashboard dev",
    "build": "pnpm --filter @pulseboard/dashboard build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project mock-api --project ui --project dashboard",
    "storybook": "pnpm --filter @pulseboard/ui storybook",
    "build-storybook": "pnpm --filter @pulseboard/ui build-storybook",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "pnpm --filter @pulseboard/dashboard e2e:ci",
    "test:coverage": "vitest run --project mock-api --project ui --project dashboard --coverage",
    "size": "size-limit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@size-limit/file": "^13.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
